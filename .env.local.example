# =====================================================================
# Naver Shopping Open API
# =====================================================================
# 1. https://developers.naver.com/apps/#/list 접속 후 애플리케이션 등록
# 2. "검색" API 사용 권한 추가
# 3. 발급받은 Client ID / Client Secret 을 아래에 입력
#
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채우세요.
#   PowerShell:  Copy-Item .env.local.example .env.local
#   bash/zsh:    cp .env.local.example .env.local
# =====================================================================

NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# =====================================================================
# Google AI (서버 전용 — 클라이언트에 노출 금지)
# =====================================================================
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
LLM_PROVIDER=gemini

# =====================================================================
# AliExpress Affiliate Open API (서버 전용)
# =====================================================================
# 1. https://open.aliexpress.com/ 에서 앱 등록
# 2. Affiliate API 권한 · App Key / App Secret 발급
# 3. 어필리에이트 Tracking ID가 있으면 promotion_link 생성에 사용
# =====================================================================

ALIEXPRESS_APP_KEY=your_aliexpress_app_key_here
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret_here
ALIEXPRESS_TRACKING_ID=
# 선택: 기본 https://api-sg.aliexpress.com/sync
# ALIEXPRESS_API_GATEWAY=
